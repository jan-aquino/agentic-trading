# ==============================================================================
# Agentic Trading System - Local Simulation Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NOTIFICATION & HUMAN CONFIRMATION SETTINGS
# ------------------------------------------------------------------------------
# Channel options:
#   'imessage' -> Native macOS Messages (Free, no account needed on Mac)
#   'twilio'   -> Twilio SMS API (For cloud servers / non-Mac environments)
#   'cli'      -> Terminal prompt only
NOTIFICATION_CHANNEL=imessage

# Your actual mobile phone number (format: +1XXXXXXXXXX or standard 10-digit)
PHONE_NUMBER=+15551234567

# Timeout in seconds to approve a trade before proposal safely expires
CONFIRMATION_TIMEOUT_SECONDS=600


# ------------------------------------------------------------------------------
# 2. ROBINHOOD MCP SETTINGS
# ------------------------------------------------------------------------------
# Keep local Python runs in paper simulation mode. Live brokerage actions use
# the official Robinhood Trading MCP authenticated by Codex or ChatGPT.
ROBINHOOD_USE_MOCK=true

ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Never store Robinhood usernames, passwords, MFA secrets, or bearer tokens here.


# ------------------------------------------------------------------------------
# 3. OPTIONAL TWILIO SETTINGS (Only required if NOTIFICATION_CHANNEL=twilio)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
